option(HIVE_ENABLE_ASAN "Enable AddressSanitizer" OFF)
option(HIVE_ENABLE_UBSAN "Enable UndefinedBehaviorSanitizer" OFF)
option(HIVE_ENABLE_TSAN "Enable ThreadSanitizer" OFF)

function(hive_enable_sanitizers target)
    if(HIVE_ENABLE_ASAN AND HIVE_ENABLE_TSAN)
        message(FATAL_ERROR "ASan and TSan cannot be enabled at the same time")
    endif()

    if(MSVC)
        if(HIVE_ENABLE_TSAN)
            message(FATAL_ERROR "TSan is not supported on MSVC; use the Linux tsan preset")
        endif()
        if(HIVE_ENABLE_ASAN)
            target_compile_options(${target} PRIVATE /fsanitize=address)
        endif()
        if(HIVE_ENABLE_UBSAN)
            message(WARNING "UBSan is not supported on MSVC; ignoring HIVE_ENABLE_UBSAN")
        endif()
        return()
    endif()

    set(flags "")
    if(HIVE_ENABLE_ASAN)
        list(APPEND flags -fsanitize=address)
    endif()
    if(HIVE_ENABLE_UBSAN)
        list(APPEND flags -fsanitize=undefined)
    endif()
    if(HIVE_ENABLE_TSAN)
        list(APPEND flags -fsanitize=thread)
    endif()

    if(flags)
        list(APPEND flags -fno-omit-frame-pointer)
        target_compile_options(${target} PRIVATE ${flags})
        target_link_options(${target} PRIVATE ${flags})
    endif()
endfunction()
